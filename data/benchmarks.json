  "benchmarks": [
    {
      "id": "frontiercode-1-1",
      "name": "FrontierCode 1.1",
      "description": "Held-out competitive and real-world code generation tasks used in Google's current model cards.",
      "unit": "%",
      "higherIsBetter": true,
      "status": "current"
    },
    {
      "id": "deepswe-v1-1",
      "name": "DeepSWE v1.1",
      "description": "Agentic software-engineering benchmark that has largely displaced SWE-bench Verified in 2026 vendor reporting.",
      "unit": "%",
      "higherIsBetter": true,
      "status": "current"
    },
    {
      "id": "terminal-bench-2-1",
      "name": "Terminal-Bench 2.1",
      "description": "Command-line agent tasks in a real terminal; the widely reported, now near-saturated version.",
      "unit": "%",
      "higherIsBetter": true,
      "status": "saturated",
      "supersededBy": "terminal-bench-3-0",
      "statusNote": "Near-saturated and two versions behind: Terminal-Bench went 2.1 to 3.0 (2026-07-30) to 4.0 (2026-08-28) in under four months, so 2.1 scores are continuity only, not a live signal."
    },
    {
      "id": "terminal-bench-3-0",
      "name": "Terminal-Bench 3.0",
      "description": "Much harder successor to Terminal-Bench 2.1, where frontier models still score under 25%.",
      "unit": "%",
      "higherIsBetter": true,
      "status": "saturated",
      "supersededBy": "terminal-bench-4-0",
      "statusNote": "Superseded by Terminal-Bench 4.0, released 2026-08-28, which is not itself in this dataset yet. Note also that 3.0 shipped first as Frontier-Bench v0.1 and was renamed, so older model cards report the same benchmark under that name."
    },
    {
      "id": "automationbench",
      "name": "AutomationBench",
      "description": "End-to-end business workflow automation tasks executed by tool-using agents.",
      "unit": "%",
      "higherIsBetter": true,
      "status": "current"
    },
    {
      "id": "osworld-2-0",
      "name": "OSWorld 2.0",
      "description": "Computer-use benchmark measuring real desktop GUI task completion.",
      "unit": "%",
      "higherIsBetter": true,
      "status": "current"
    },
    {
      "id": "gdpval-aa-v2",
      "name": "GDPval-AA v2",
      "description": "Elo-rated head-to-head evaluation on economically valuable knowledge work.",
      "unit": "Elo",
      "higherIsBetter": true,
      "status": "current"
    },
    {
      "id": "code-arena-webdev",
      "name": "Code Arena (Web Development)",
      "description": "Human-preference Elo for web development coding tasks.",
      "unit": "Elo",
      "higherIsBetter": true,
      "status": "current"
    },
    {
      "id": "hle-verified",
      "name": "HLE-Verified",
      "description": "Verified subset of Humanity's Last Exam, a very hard closed-ended academic exam.",
      "unit": "%",
      "higherIsBetter": true,
      "status": "current",
      "statusNote": "The verified rebuild of Humanity's Last Exam, after roughly 30% of the original chemistry and biology answer keys were judged wrong; original-HLE scores are not comparable to these."
    },
    {
      "id": "agents-last-exam",
      "name": "Agent's Last Exam",
      "description": "Long-horizon agentic reasoning benchmark, the agent-era counterpart to HLE.",
